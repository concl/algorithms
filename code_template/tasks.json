{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build current file with g++",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build the currently open C++ file"
        },
        {
            "label": "Run c++ file with the tester.py script on testcases",
            "type": "shell",
            "command": "python ${workspaceFolder}/tester.py ${file} ${workspaceFolder}/workspace/input.txt"
        }
    ]
}